{
  // Default: retain useful text with caveats; use "strict" to reject contract violations. Policy success is not factual proof.
  "result_policy": "compromise",
  // Briefly describe the system's purpose and history. Empty/missing means a warning.
  "project_description": "An ERP system originally developed in 1995",

  // Choose "git" or "folder". Only the selected section is used.
  "mode": "git",

  // A clean standalone checkout and one or more existing local branches.
  // For one branch, use ["master"] and baseline_branch: "master"; compare is skipped.
  "git_mode": {
    "repository": "../legacy-app",
    "branches": ["master", "lockheed_ver10.2a.0", "general_ver10.0"],
    "baseline_branch": "master",
  },

  // An existing directory; Git is not required. Review and revision are opt-in.
  "folder_mode": {
    "path": "../legacy-app",
  },

  // All relative paths are relative to this configuration file; ~ is supported.
  // Keep reports and this package outside the inspected source directory.
  "reports_dir": "../architecture-reports/legacy-app",
  "output_language": "English",

  // Source filtering is opt-in. Paths below are examples, not application defaults.
  // Review each entry: legacy code and resources can use these directory names.
  // Use exact source-root-relative paths with "/"; directories exclude their contents.
  // "node_modules" does not match "packages/web/node_modules". No globs here.
  "source_filter": {
    // Folder mode only; works without .git. Git keeps its normal ignore behavior.
    "follow_gitignore": false,
    "exclude_paths": [
      // Uncomment only the paths you want to exclude.
      // General: VCS, IDE and temporary artifacts
      // ".git", ".hg", ".svn", ".idea", ".vs", ".DS_Store", ".cache",
      // "build", "dist", "temp", "tmp", "coverage",
      // Java: Maven, Gradle, Spring Boot, Quarkus, Micronaut, Jakarta EE, Android
      // ".gradle", "target", "out", ".cxx", "android/.gradle", "android/.cxx",
      // "android/build", "android/app/build", "app/build",
      // JS/TS: React, Next.js, Vue, Nuxt, Angular, SvelteKit, Astro, Vite,
      // NestJS, Remix, Electron, Expo
      // "node_modules", "bower_components", ".next", ".nuxt", ".nitro", ".output",
      // ".angular/cache", ".svelte-kit", ".astro", ".vite", ".turbo", ".parcel-cache",
      // ".expo", ".vercel", ".netlify", ".yarn/cache", ".pnpm-store",
      // "storybook-static", "playwright-report", "test-results",
      // C/C++: CMake, Qt, Meson, Ninja, Autotools, Bazel, Unreal Engine
      // "CMakeFiles", "CMakeCache.txt", "cmake-build-debug", "cmake-build-release",
      // "cmake-build-relwithdebinfo", "cmake-build-minsizerel", "autom4te.cache",
      // ".deps", ".libs", "bazel-out", "bazel-bin", "bazel-testlogs",
      // "Binaries", "Intermediate", "DerivedDataCache",
      // Rust: Cargo, Actix Web, Axum, Rocket, Bevy, Tauri; also uses "target" above
      // ".rustc_info.json", "src-tauri/target",
      // Go: Gin, Echo, Fiber, Buffalo, standard tools; no mandatory build directory
      // "coverage.out", "__debug_bin",
      // Python: Django, Flask, FastAPI, Celery, pytest, mypy, Ruff, tox, Poetry, Jupyter
      // ".venv", "venv", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache",
      // ".tox", ".nox", ".hypothesis", ".ipynb_checkpoints", ".eggs", ".pytype",
      // "__pypackages__", "htmlcov", "staticfiles",
      // Swift: SwiftPM, Xcode, SwiftUI, UIKit, Vapor, Carthage
      // ".build", "DerivedData", "Carthage/Build", "ios/build",
      // Extra review required: these often contain source, scripts or resources.
      // "Pods", "ios/Pods", "Carthage/Checkouts", "vendor", "bin", "Saved"
    ],
  },
  // Evidence checks; also symbol-map decoding when source_context is enabled.
  // Paths are relative to the common source root.
  // Additional reads depend on CLI capabilities. No UTF-8 copies are created on disk.
  // Most specific path wins; "." selects the whole tree.
  "source_decoding": {
    "rules": [
      // {"path": "src/legacy", "encoding": "cp1251"}
    ],
  },

  // One monotonic budget per stage. null disables the optional idle deadline.
  // opencode_format_retries is retained for compatibility and has no effect.
  // Full inventory is parsed. Read symbol maps on demand with native read-only tools.
  "source_context": {
    "enabled": true,
    // Default: "on-demand". "full" sends all symbols in the initial prompt.
    // enabled=false disables map preparation and export in either mode.
    "mode": "on-demand",
  },
  "execution": {
    // Stop only after 50 confirmed repeated tool results spanning 120 seconds.
    // false keeps observation metrics and disables this stop.
    "read_loop_guard": true,
    // Optional separate review. Omitted means false; set true for the reviewed workflow.
    "review_enabled": false,
    // Used only with review enabled: one revision and full review after material findings.
    "max_revision_rounds": 1,
    "stage_timeout_seconds": 3600,
    "idle_timeout_seconds": null,
    "opencode_format_retries": 2,
    "http_timeout_seconds": 5,
    "api_doc_timeout_seconds": 30,
    // Legacy compatibility key; ignored by all backends. No orchestrator format retry.
    "structured_output_repair_attempts": 1,
  },

  // Shared CLI settings. Authenticate/configure the CLI before starting the runner.
  "agent": {
    // Supported backends: "codex", "opencode", "xxx".
    "backend": "codex",
    // Command on PATH or executable path. Defaults: codex / opencode / xxx.
    "executable": "codex",
    // null uses the model selected by the configured CLI.
    "model": "gpt-6-astra",
    // null disables version pinning; otherwise use the exact --version output.
    "expected_version": null,
  },

  // Uncomment only the fields you want to override; omitted fields inherit agent.
  // When changing backend, also override executable and any inherited model/version.
  // model: null selects the CLI's model; expected_version: null clears version pinning.
  "stage_agents": {
    // Substantive revision always uses study.
    "study": {
      // "backend": "codex",
      // "executable": "codex",
      // "model": null,
      // "expected_version": null,
    },
    "review": {
      // "backend": "codex",
      // "executable": "codex",
      // "model": null,
      // "expected_version": null,
    },
    // Used only in git mode with two or more selected branches.
    "compare": {
      // "backend": "codex",
      // "executable": "codex",
      // "model": null,
      // "expected_version": null,
    },
  },

  // Business flows or areas to prioritize, e.g. ["Order creation", "Inventory updates"].
  "priority_scenarios": [],
  // Continue after recoverable stage failures, with retained material under compromise policy.
  // false stops further agent calls in both modes; integrity, cleanup and publication failures always stop.
  "continue_on_error": true,

  // Omitted entries use bundled prompts, even if this config is moved elsewhere.
  // Custom prompts must be outside the source directory and match the output schema.
  "prompts": {
    // "study": "./custom-prompts/study.md",
    // "revise": "./custom-prompts/revise.md",
    // "review": "./custom-prompts/review.md",
    // "compare": "./custom-prompts/compare.md", // Git mode with two or more branches only.
  },
}
