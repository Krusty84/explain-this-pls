{
  // Default: retain useful text with caveats; use "strict" to reject contract violations. Policy success is not factual proof.
  "result_policy": "compromise",
  "project_description": "Legacy application architecture audit using OpenCode 1.2.27 / XXX",
  "mode": "folder",
  "folder_mode": {"path": "../legacy-app"},
  "git_mode": {
    "repository": "../legacy-app",
    "branches": ["main", "customer-version"],
    "baseline_branch": "main"
  },
  "reports_dir": "../architecture-reports/legacy-app",
  "output_language": "English",

  // Source filtering is opt-in. Paths below are examples, not application defaults.
  // Review each entry: legacy code and resources can use these directory names.
  // Use exact source-root-relative paths with "/"; directories exclude their contents.
  // "node_modules" does not match "packages/web/node_modules". No globs here.
  "source_filter": {
    // Folder mode only; works without .git. Git keeps its normal ignore behavior.
    "follow_gitignore": false,
    "exclude_paths": [
      // Uncomment only the paths you want to exclude.
      // General: VCS, IDE and temporary artifacts
      // ".git", ".hg", ".svn", ".idea", ".vs", ".DS_Store", ".cache",
      // "build", "dist", "temp", "tmp", "coverage",

      // Java: Maven, Gradle, Spring Boot, Quarkus, Micronaut, Jakarta EE, Android
      // ".gradle", "target", "out", ".cxx", "android/.gradle", "android/.cxx",
      // "android/build", "android/app/build", "app/build",

      // JS/TS: React, Next.js, Vue, Nuxt, Angular, SvelteKit, Astro, Vite,
      // NestJS, Remix, Electron, Expo
      // "node_modules", "bower_components", ".next", ".nuxt", ".nitro", ".output",
      // ".angular/cache", ".svelte-kit", ".astro", ".vite", ".turbo", ".parcel-cache",
      // ".expo", ".vercel", ".netlify", ".yarn/cache", ".pnpm-store",
      // "storybook-static", "playwright-report", "test-results",

      // C/C++: CMake, Qt, Meson, Ninja, Autotools, Bazel, Unreal Engine
      // "CMakeFiles", "CMakeCache.txt", "cmake-build-debug", "cmake-build-release",
      // "cmake-build-relwithdebinfo", "cmake-build-minsizerel", "autom4te.cache",
      // ".deps", ".libs", "bazel-out", "bazel-bin", "bazel-testlogs",
      // "Binaries", "Intermediate", "DerivedDataCache",

      // Rust: Cargo, Actix Web, Axum, Rocket, Bevy, Tauri; also uses "target" above
      // ".rustc_info.json", "src-tauri/target",

      // Go: Gin, Echo, Fiber, Buffalo, standard tools; no mandatory build directory
      // "coverage.out", "__debug_bin",

      // Python: Django, Flask, FastAPI, Celery, pytest, mypy, Ruff, tox, Poetry, Jupyter
      // ".venv", "venv", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache",
      // ".tox", ".nox", ".hypothesis", ".ipynb_checkpoints", ".eggs", ".pytype",
      // "__pypackages__", "htmlcov", "staticfiles",

      // Swift: SwiftPM, Xcode, SwiftUI, UIKit, Vapor, Carthage
      // ".build", "DerivedData", "Carthage/Build", "ios/build",

      // Extra review required: these often contain source, scripts or resources.
      // "Pods", "ios/Pods", "Carthage/Checkouts", "vendor", "bin", "Saved"
    ]
  },
  // Evidence checks; also symbol-map decoding when source_context is enabled.
  // Paths are relative to the common source root.
  // Additional reads depend on CLI capabilities. No UTF-8 copies are created on disk.
  // Most specific path wins; "." selects the whole tree.
  "source_decoding": {
    "rules": [
      // {"path": "src/legacy", "encoding": "cp1251"}
    ]
  },
  "agent": {
    // XXX is OpenCode 1.2.27 over CLI; opencode selects the separate V2 CLI.
    "backend": "xxx",
    // Set to your OpenCode 1.2.27 or XXX command/path. No installation is done.
    "executable": "xxx",
    // null preserves the agent's configured provider/model and authentication.
    "model": null,
    // Optional exact output of this executable's --version, not its upstream version.
    "expected_version": null
  },
  // Full index-only file/symbol map. Implementations use native read-only tools.
  "source_context": {
    "enabled": true
  },
  "execution": {
    // Stop only after 50 confirmed repeated tool results spanning 120 seconds.
    // false keeps observation metrics and disables this stop.
    "read_loop_guard": true,
    // Optional separate review. Omitted means false; revision rounds apply only when true.
    "review_enabled": false,
    // Automatic compaction stays inside the single CLI run for each stage.
    // Final JSON is checked locally against the schema; no format retry is sent.
    // structured_output_repair_attempts is a legacy key ignored by all backends.
    // Used only with review enabled: one revision and full review after material findings.
    "max_revision_rounds": 1,
    "stage_timeout_seconds": 3600,
    "idle_timeout_seconds": null
  },
  "stage_agents": {},
  "priority_scenarios": [],
  "continue_on_error": true,
  "prompts": {}
}
