{
  // Default: retain useful text with caveats; use "strict" to reject contract violations. Policy success is not factual proof.
  "result_policy": "compromise",
  // OpenCode V2 (checked with 2.0.23): standalone CLI, final JSON validated locally.
  // --check verifies the CLI version and flags without a model request.
  // Briefly describe the system's purpose and history. Empty/missing means a warning.
  "project_description": "An ERP system originally developed in 1995",

  // Choose "git" or "folder". Only the selected section is used.
  "mode": "git",

  // A clean standalone checkout and one or more existing local branches.
  // For one branch, use ["master"] and baseline_branch: "master"; compare is skipped.
  "git_mode": {
    "repository": "../legacy-app",
    "branches": ["master", "lockheed_ver10.2a.0", "general_ver10.0"],
    "baseline_branch": "master",
  },

  // An existing directory; Git is not required. Review and revision are opt-in.
  "folder_mode": {
    "path": "../legacy-app",
  },

  // All relative paths are relative to this configuration file; ~ is supported.
  // Keep reports and this package outside the inspected source directory.
  "reports_dir": "../architecture-reports/legacy-app",
  "output_language": "English",

  // Evidence verification only; paths are relative to the common source root.
  // Most specific path wins; "." selects the whole tree. No agent UTF-8 copies.
  "source_decoding": {
    "rules": [
      // {"path": "src/legacy", "encoding": "cp1251"}
    ],
  },

  "execution": {
    // Optional separate review. Omitted means false; set true for the reviewed workflow.
    "review_enabled": false,
    // Used only with review enabled: one revision and full review after material findings.
    "max_revision_rounds": 1,
    "stage_timeout_seconds": 3600,
    "idle_timeout_seconds": null,
    // Legacy compatibility key; ignored by OpenCode V2.
    "opencode_format_retries": 0,
    // HTTP timeouts apply only to XXX stages.
    "http_timeout_seconds": 5,
    "api_doc_timeout_seconds": 30,
    // Applies only to XXX; OpenCode V2 makes one CLI invocation per attempt.
    "structured_output_repair_attempts": 0,
  },

  // Shared CLI settings. Authenticate/configure the CLI before starting the runner.
  "agent": {
    // Supported backends: "codex", "claude-code", "opencode", "xxx".
    "backend": "opencode",
    // Command on PATH or executable path. Defaults: codex / claude / opencode / xxx.
    "executable": "opencode",
    // null uses the model selected by the configured CLI.
    "model": "deepseek/deepseek-flash",
    // Optional exact --version output pin, for example "opencode v2.0.23".
    "expected_version": null,
  },

  // Uncomment only the fields you want to override; omitted fields inherit agent.
  // When changing backend, also override executable and any inherited model/version.
  // model: null selects the CLI's model; expected_version: null clears version pinning.
  "stage_agents": {
    // Catalog inherits study settings; substantive revision always uses study.
    "catalog": {},
    "study": {
      // "backend": "opencode",
      // "executable": "opencode",
      // "model": null,
      // "expected_version": null,
    },
    "review": {
      // "backend": "opencode",
      // "executable": "opencode",
      // "model": null,
      // "expected_version": null,
    },
    // Used only in git mode with two or more selected branches.
    "compare": {
      // "backend": "opencode",
      // "executable": "opencode",
      // "model": null,
      // "expected_version": null,
    },
  },

  // Business flows or areas to prioritize, e.g. ["Order creation", "Inventory updates"].
  "priority_scenarios": [],
  // Continue after recoverable stage failures, including catalog fallback in folder mode.
  // false stops further agent calls in both modes; integrity, cleanup and publication failures always stop.
  "continue_on_error": true,

  // Omitted entries use bundled prompts, even if this config is moved elsewhere.
  // Custom prompts must be outside the source directory and match the output schema.
  "prompts": {
    // "catalog": "./custom-prompts/catalog.md",
    // "study": "./custom-prompts/study.md",
    // "revise": "./custom-prompts/revise.md",
    // "review": "./custom-prompts/review.md",
    // "compare": "./custom-prompts/compare.md", // Git mode with two or more branches only.
  },
}
