                  "git",
                  "folder"
                ]
              },
              "branch": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "directory": {
                "type": "string"
              },
              "fingerprint": {
                "type": "string"
              },
              "parent_commit": {
                "type": "string"
              },
              "submodule_path": {
                "type": "string"
