            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "entry_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "purpose",
          "paths",
          "entry_paths",
          "file_paths",
          "required"
