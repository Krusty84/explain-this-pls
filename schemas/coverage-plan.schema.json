  "properties": {
    "contract_id": {
      "type": "string",
      "enum": [
        "evidence-ledger"
      ]
    },
    "artifact_format": {
      "type": "string",
      "enum": [
        "architecture-artifacts"
      ]
    },
    "origin": {
      "type": "string",
      "enum": [
        "SOURCE_INVENTORY"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "identity": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "git",
                  "folder"
                ]
              },
              "branch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "commit": {
                "type": "string"
              },
              "directory": {
                "type": "string"
              },
              "fingerprint": {
                "type": "string"
              },
              "parent_commit": {
                "type": "string"
              },
              "submodule_path": {
                "type": "string"
              },
              "repository": {
                "type": "string"
              },
              "base_commit": {
                "type": "string"
              },
              "source_type": {
                "type": "string",
                "enum": [
                  "commit",
                  "working_tree"
                ]
              },
              "snapshot_id": {
                "type": "string"
              },
              "submodule_head": {
                "type": "string"
              }
            },
            "required": [
              "mode"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "root",
          "identity"
        ],
        "additionalProperties": false
      }
    },
    "inventory_sha256": {
      "type": "string"
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "entry_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "purpose",
          "paths",
          "entry_paths",
          "file_paths",
          "required"
        ],
        "additionalProperties": false
      }
