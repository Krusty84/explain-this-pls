{
  "type": "object",
  "properties": {
    "completion_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "report_markdown": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task": {
      "type": "string",
      "enum": [
        "architecture_review"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "CHANGES_REQUIRED",
        "INCONCLUSIVE"
      ]
    },
    "claim_inventory_complete": {
      "type": "boolean"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "SUPPORTED",
              "CONTRADICTED",
              "UNVERIFIABLE",
              "NOT_CHECKED"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitation": {
            "type": "string",
            "description": "Required. Use an empty string when no limitation applies; unchecked/unverifiable claims require a reason."
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Required links to findings (F-...). Use [] when none. Never put claim_ids in a claim."
          }
        },
        "required": [
          "id",
          "location",
          "statement",
          "outcome",
          "evidence",
          "limitation",
          "finding_ids"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "FACTUAL_ERROR",
              "UNSUPPORTED_ASSERTION",
              "MATERIAL_OMISSION",
              "SCOPE_MISMATCH",
              "CONTRACT_VIOLATION"
            ]
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Required links to claims (C-...). Use [] when no existing claim applies. Only findings have claim_ids."
          },
          "location": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impact": {
            "type": "string"
          },
          "proposed_correction": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "severity",
          "type",
          "claim_ids",
          "location",
          "evidence",
          "impact",
          "proposed_correction"
        ],
        "additionalProperties": false
      }
    },
    "source_directory": {
      "type": "string"
    },
    "source_fingerprint": {
      "type": "string"
    }
  },
  "required": [
    "completion_status",
    "report_markdown",
    "limitations",
    "task",
    "verdict",
    "claim_inventory_complete",
    "claims",
    "findings",
    "source_directory",
    "source_fingerprint"
  ],
  "additionalProperties": false
}
